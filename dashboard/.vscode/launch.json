{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🌊 Streamlit: Launch Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/app.py",
                "--server.port=8501"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "🤖 Python: Run Model Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train.py",
            "console": "integratedTerminal"
        },
        {
            "name": "📊 Python: Generate Visualizations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/generate_visualizations.py",
            "console": "integratedTerminal"
        },
        {
            "name": "🔍 Python: Run Prediction Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/predict.py",
            "console": "integratedTerminal"
        }
    ]
}
