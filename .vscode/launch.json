{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🧠 MindGraphNet: Launch Streamlit Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/MindGraphNet/dashboard/streamlit_app.py",
                "--server.port=8501"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🚀 MindGraphNet: Run Full Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/MindGraphNet/MindGraphNet_Enhanced_Pipeline.py",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⚡ MindGraphNet: Start FastAPI Microservice",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "MindGraphNet.api.app:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000",
                "--reload"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🧪 MindGraphNet: Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "MindGraphNet/tests/test_pipeline.py"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "PYTHONIOENCODING": "utf-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🌊 River Water: Launch Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/dashboard/app.py",
                "--server.port=8502"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
